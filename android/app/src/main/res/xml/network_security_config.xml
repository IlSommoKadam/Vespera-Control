<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo HTTPS per cataloghi e aggiornamenti.
  FTP e ADB verso il telescopio usano socket TCP diretti, non questa policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
