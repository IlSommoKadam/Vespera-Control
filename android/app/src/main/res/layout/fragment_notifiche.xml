<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_section_panel"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_telegram"
                android:textColor="@color/vespera_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTelegramStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/vespera_muted"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/checkTelegramEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/telegram_enable_all"
                android:textColor="@color/vespera_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/telegram_enable_hint"
                android:textColor="@color/vespera_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_section_panel"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/telegram_events_title"
                android:textColor="@color/vespera_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/gridTelegramEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/telegram_events_hint"
                android:textColor="@color/vespera_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_section_panel"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plans_share_title"
                android:textColor="@color/vespera_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/plans_share_hint"
                android:textColor="@color/vespera_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editPlansToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/plans_bot_token"
                android:inputType="textPassword"
                android:textColor="@color/vespera_text" />

            <EditText
                android:id="@+id/editPlansChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/plans_bot_chat"
                android:inputType="numberSigned"
                android:textColor="@color/vespera_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlansFromHelper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/plans_bot_from_helper" />

                <Button
                    android:id="@+id/btnPlansSync"
                    style="@style/Widget.Vespera.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/plans_bot_sync" />
            </LinearLayout>

            <TextView
                android:id="@+id/textPlansStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/vespera_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
