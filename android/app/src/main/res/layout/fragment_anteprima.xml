<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tab_anteprima"
        android:textColor="@color/vespera_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editFtpHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="@string/hint_ftp_host"
            android:inputType="text"
            android:text="192.168.1.50"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />

        <EditText
            android:id="@+id/editFtpPort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/hint_ftp_port"
            android:inputType="number"
            android:text="2121"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Porte: 2121 HD · 2122 telescopio. Tocca un oggetto per l'ultimo *-output.jpg (niente stacking)."
        android:textColor="@color/vespera_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFtpConnect"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_ftp_connect" />

        <Button
            android:id="@+id/btnFtpRefresh"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_ftp_refresh" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_file_list"
        android:textColor="@color/vespera_title"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listFtpFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_section_panel" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_preview"
        android:textColor="@color/vespera_title"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imagePreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:background="@color/vespera_ink"
        android:contentDescription="@string/placeholder_no_preview"
        android:scaleType="fitCenter" />
</LinearLayout>
