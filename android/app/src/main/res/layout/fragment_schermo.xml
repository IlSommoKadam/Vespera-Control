<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_schermo"
            android:textColor="@color/vespera_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Integrazione prevista con org.client.scrcpy dal fork Scrcpy-for-Android. Per ora solo stub."
            android:textColor="@color/vespera_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editMirrorIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_device_ip"
            android:inputType="text"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />

        <EditText
            android:id="@+id/editMirrorPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_scrcpy_port"
            android:inputType="number"
            android:text="27183"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />

        <EditText
            android:id="@+id/editMirrorBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_bitrate"
            android:inputType="number"
            android:text="8"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />

        <Button
            android:id="@+id/btnOpenMirror"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_open_mirror" />
    </LinearLayout>
</ScrollView>
