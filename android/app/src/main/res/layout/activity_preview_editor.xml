<?xml version="1.0" encoding="utf-8"?>
<!-- The outer frame takes the system-bar insets as padding, so the coordinator (and the
     BottomSheetBehavior, which ignores parent padding) never extends under the nav bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg">

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/editorCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.vaonis.vesperacontrol.ui.anteprima.PreviewCanvasView
        android:id="@+id/previewCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/editorTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vespera_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/textEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/vespera_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnEditorShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_editor_icon"
            android:backgroundTint="@color/vespera_slate"
            android:contentDescription="@string/editor_share"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_share"
            android:tooltipText="@string/editor_share" />

        <ImageButton
            android:id="@+id/btnEditorSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_editor_icon"
            android:backgroundTint="@color/vespera_green"
            android:contentDescription="@string/editor_save"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_save"
            android:tooltipText="@string/editor_save" />

        <ImageButton
            android:id="@+id/btnEditorClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_editor_icon"
            android:backgroundTint="@color/vespera_slate"
            android:contentDescription="@string/editor_close"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_close"
            android:tooltipText="@string/editor_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editorSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_editor_sheet"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="120dp"
        app:gestureInsetBottomIgnored="true"
        app:paddingBottomSystemWindowInsets="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/editorSheetChrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_editor_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <Button
                    android:id="@+id/btnToolLevels"
                    style="@style/Widget.Vespera.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/editor_regolazione" />

                <Button
                    android:id="@+id/btnToolGeometry"
                    style="@style/Widget.Vespera.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/editor_geometria" />

                <Button
                    android:id="@+id/btnFit"
                    style="@style/Widget.Vespera.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/editor_fit" />
            </LinearLayout>

            <TextView
                android:id="@+id/textEditorHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:text="@string/editor_canvas_help"
                android:textColor="@color/vespera_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/editorToolsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/panelLevels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAutostretch"
                            style="@style/Widget.Vespera.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/editor_autostretch" />

                        <Button
                            android:id="@+id/btnResetLevels"
                            style="@style/Widget.Vespera.Button.Slate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/editor_reset" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_black"
                            android:textColor="@color/vespera_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textBlack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vespera_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBlack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="95" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_mid"
                            android:textColor="@color/vespera_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textMid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vespera_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekMid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="280" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_white"
                            android:textColor="@color/vespera_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vespera_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekWhite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="95" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_sat"
                            android:textColor="@color/vespera_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textSat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vespera_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekSat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="200" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelGeometry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRotateLeft"
                            style="@style/Widget.Vespera.Button.Slate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/editor_rotate_left" />

                        <Button
                            android:id="@+id/btnRotateRight"
                            style="@style/Widget.Vespera.Button.Slate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/editor_rotate_right" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_crop_w"
                            android:textColor="@color/vespera_text"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/editCropW"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="W"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/vespera_text"
                            android:textColorHint="@color/vespera_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/editor_crop_h"
                            android:textColor="@color/vespera_text"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/editCropH"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="H"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/vespera_text"
                            android:textColorHint="@color/vespera_muted" />

                        <Button
                            android:id="@+id/btnCropSizeApply"
                            style="@style/Widget.Vespera.Button.Slate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="40dp"
                            android:text="@string/editor_crop_size_apply" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCrop"
                            style="@style/Widget.Vespera.Button.Slate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/editor_crop" />

                        <Button
                            android:id="@+id/btnApplyCrop"
                            style="@style/Widget.Vespera.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:minHeight="40dp"
                            android:text="@string/editor_apply_crop" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnClearCrop"
                        style="@style/Widget.Vespera.Button.Slate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="40dp"
                        android:text="@string/editor_clear_crop" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
