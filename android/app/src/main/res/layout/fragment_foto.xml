<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_hd"
            android:textColor="@color/vespera_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textHdStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/vespera_text_secondary" />

        <Button
            android:id="@+id/btnHdList"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_take_photo" />

        <Button
            android:id="@+id/btnHdMount"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_mount_hd" />

        <Button
            android:id="@+id/btnHdEject"
            style="@style/Widget.Vespera.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_unmount_hd" />

        <Button
            android:id="@+id/btnHdWake"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_hd_wake" />

        <Button
            android:id="@+id/btnSyncNow"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop_obs" />

        <TextView
            android:id="@+id/textFotoLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/vespera_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_sync_queue"
            android:textColor="@color/vespera_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSyncSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="—"
            android:textColor="@color/vespera_text_secondary" />

        <ProgressBar
            android:id="@+id/progressSync"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressTint="@color/vespera_accent" />

        <TextView
            android:id="@+id/textSyncCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text=""
            android:textColor="@color/vespera_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSyncPause"
                style="@style/Widget.Vespera.Button.Slate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_sync_pause" />

            <Button
                android:id="@+id/btnSyncResume"
                style="@style/Widget.Vespera.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_sync_resume" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSyncQueueEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sync_queue_empty"
            android:textColor="@color/vespera_muted" />

        <LinearLayout
            android:id="@+id/listSyncQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
    </LinearLayout>
</ScrollView>
