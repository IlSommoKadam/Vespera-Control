<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_foto"
            android:textColor="@color/vespera_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTakePhoto"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_take_photo" />

        <Button
            android:id="@+id/btnStartObs"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_obs" />

        <Button
            android:id="@+id/btnStopObs"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop_obs" />

        <TextView
            android:id="@+id/textFotoLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/vespera_muted" />
    </LinearLayout>
</ScrollView>
