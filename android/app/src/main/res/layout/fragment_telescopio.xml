<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollTelescopio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_telescope"
            android:textColor="@color/vespera_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/vespera_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUnpark"
                style="@style/Widget.Vespera.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_unpark" />

            <Button
                android:id="@+id/btnPark"
                style="@style/Widget.Vespera.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_park" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAbort"
                style="@style/Widget.Vespera.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_abort" />

            <Button
                android:id="@+id/btnGoto"
                style="@style/Widget.Vespera.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_goto" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShutdown"
            style="@style/Widget.Vespera.Button.Warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_shutdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Movimento manuale"
            android:textColor="@color/vespera_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textMotorPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Posizione: AZ —  ·  ALT —"
            android:textColor="@color/vespera_title" />

        <RadioGroup
            android:id="@+id/groupMotorAxis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioAxisAz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Azimut (AZ)" />

            <RadioButton
                android:id="@+id/radioAxisAlt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Elevazione (ALT)" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/groupMotorMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioModeRel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Relativo (± gradi)" />

            <RadioButton
                android:id="@+id/radioModeAbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Assoluto (posizione)" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editAzStep"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:hint="°"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:text="+5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="°" />

            <Button
                android:id="@+id/btnMotorGo"
                style="@style/Widget.Vespera.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vai" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relativo: +5 / −10 muove l'asse di quei gradi dalla posizione attuale (max ±180°). Assoluto: porta l'asse alla posizione (AZ 0…360°, ALT −90…90°; −90° = braccio chiuso). «Vai» è attivo solo a telescopio fermo."
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAzStop"
            style="@style/Widget.Vespera.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ Stop movimento" />

        <TextView
            android:id="@+id/textCable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cavo: —"
            android:textColor="@color/vespera_title" />

        <Button
            android:id="@+id/btnCableZero"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set posizione iniziale (cavo dritto)" />

        <CheckBox
            android:id="@+id/checkCableAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Riposiziona da solo al Set (fine osservazione e di giorno)"
            android:textColor="@color/vespera_muted" />

        <TextView
            android:id="@+id/textTelescopioLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/vespera_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/telescope_section_details"
            android:textColor="@color/vespera_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTelDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="—"
            android:textColor="@color/vespera_text_secondary" />
    </LinearLayout>
</ScrollView>
