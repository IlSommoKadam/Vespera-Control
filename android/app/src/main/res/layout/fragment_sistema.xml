<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_sistema"
            android:textColor="@color/vespera_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMountHdSistema"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_mount_hd" />

        <Button
            android:id="@+id/btnUnmountHdSistema"
            style="@style/Widget.Vespera.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_unmount_hd" />

        <Button
            android:id="@+id/btnReboot"
            style="@style/Widget.Vespera.Button.Warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_reboot" />

        <Button
            android:id="@+id/btnRefreshSistema"
            style="@style/Widget.Vespera.Button.Slate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_refresh_status" />

        <TextView
            android:id="@+id/textSistemaLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/vespera_muted" />
    </LinearLayout>
</ScrollView>
