<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vespera_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_panel"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_impostazioni"
            android:textColor="@color/vespera_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_settings_network"
            android:textColor="@color/vespera_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_settings_network"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="IP del Pi  ·  porta ADB"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editSetIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_device_ip"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/vespera_text"
                android:textColorHint="@color/vespera_muted" />

            <EditText
                android:id="@+id/editSetAdbPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_adb_port"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/vespera_text"
                android:textColorHint="@color/vespera_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Porta FTP HD  ·  porta FTP Vespera  ·  porta ADB Schermo Pi"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editSetFtpHd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_ftp_hd_port"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/vespera_text"
                android:textColorHint="@color/vespera_muted" />

            <EditText
                android:id="@+id/editSetFtpVespera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_ftp_vespera_port"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/vespera_text"
                android:textColorHint="@color/vespera_muted" />

            <EditText
                android:id="@+id/editSetScrcpyPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_scrcpy_adb_port"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/vespera_text"
                android:textColorHint="@color/vespera_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_settings_site"
            android:textColor="@color/vespera_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_settings_site"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editSiteLat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_site_lat"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />

        <EditText
            android:id="@+id/editSiteLon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_site_lon"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/vespera_text"
            android:textColorHint="@color/vespera_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSiteGps"
                style="@style/Widget.Vespera.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_site_gps" />

            <Button
                android:id="@+id/btnSiteVespera"
                style="@style/Widget.Vespera.Button.Slate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_site_vespera" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSiteSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_updates"
            android:textColor="@color/vespera_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_updates_auto"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCheckUpdates"
            style="@style/Widget.Vespera.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_check_updates" />

        <TextView
            android:id="@+id/textUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/vespera_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
