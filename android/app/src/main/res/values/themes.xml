<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VesperaControl" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/vespera_green</item>
        <item name="colorPrimaryVariant">@color/vespera_slate</item>
        <item name="colorSecondary">@color/vespera_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/vespera_surface</item>
        <item name="colorOnSurface">@color/vespera_text</item>
        <item name="android:statusBarColor">@color/vespera_bg</item>
        <item name="android:navigationBarColor">@color/vespera_bg</item>
        <item name="android:windowBackground">@color/vespera_bg</item>
        <item name="android:textColorPrimary">@color/vespera_text</item>
        <item name="android:textColorSecondary">@color/vespera_muted</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.Vespera.Button.Slate</item>
    </style>

    <style name="Widget.Vespera.Button.Slate" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/vespera_slate</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.Vespera.Button.Primary" parent="Widget.Vespera.Button.Slate">
        <item name="backgroundTint">@color/vespera_green</item>
    </style>

    <style name="Widget.Vespera.Button.Danger" parent="Widget.Vespera.Button.Slate">
        <item name="backgroundTint">@color/vespera_rose</item>
    </style>

    <style name="Widget.Vespera.Button.Warn" parent="Widget.Vespera.Button.Slate">
        <item name="backgroundTint">@color/vespera_terracotta</item>
    </style>

    <style name="Widget.Vespera.Button.Compact" parent="Widget.Vespera.Button.Slate">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Vespera.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabBackground">@drawable/bg_tab_idle</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabTextColor">@color/vespera_tab_idle_text</item>
        <item name="tabIndicatorColor">@color/vespera_green</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">@color/vespera_slate_muted</item>
        <item name="tabMode">scrollable</item>
        <item name="tabTextAppearance">@style/TextAppearance.Vespera.Tab</item>
    </style>

    <style name="TextAppearance.Vespera.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Vespera.SectionTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/vespera_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
